{
  "desktop": {
    "installers": {
      "macos": [
        "dmg"
      ],
      "linux": [
        "tar.gz",
        "deb"
      ],
      "windows": [
        "zip"
      ]
    },
    "app": {
      "name": "Fleet",
      "identifier": "dev.brainwires.fleet",
      "icons": {
        "macos": "./icons/app.png",
        "linux": "./icons/app.png",
        "windows": "./icons/app.ico"
      },
      "origin": "fleet://app",
      "singleInstance": true,
      "keepAlive": true,
      "dock": "while-window-open"
    },
    "window": {
      "defaultWidth": 1320,
      "defaultHeight": 860,
      "title": "Fleet",
      "show": false,
      "key": "fleet"
    },
    "minSize": {
      "width": 860,
      "height": 560
    },
    "tray": {
      "icon": "/tray.png",
      "tooltip": "Fleet",
      "menu": [
        {
          "id": "toggle",
          "label": "Open Fleet"
        },
        {
          "id": "summary",
          "label": "Starting…",
          "disabled": true
        },
        {
          "separator": true
        },
        {
          "id": "settings",
          "label": "Settings…"
        },
        {
          "id": "pause-notifications",
          "label": "Pause notifications",
          "checked": false
        },
        {
          "id": "refresh",
          "label": "Refresh now"
        },
        {
          "separator": true
        },
        {
          "id": "quit",
          "label": "Quit Fleet"
        }
      ]
    },
    "webViews": {
      "allowedOrigins": [
        "https://github.com"
      ]
    },
    "secureStore": {
      "legacy": false
    },
    "capabilities": {
      "secureStore": true,
      "notifications": true,
      "launchAtLogin": true,
      "extensions": [
        "./desktop/fleet.ts"
      ]
    },
    "extraPermissions": {
      "netConnect": [
        "api.github.com",
        "productionresultssa0.blob.core.windows.net",
        "productionresultssa1.blob.core.windows.net",
        "productionresultssa2.blob.core.windows.net",
        "productionresultssa3.blob.core.windows.net",
        "productionresultssa4.blob.core.windows.net",
        "productionresultssa5.blob.core.windows.net",
        "productionresultssa6.blob.core.windows.net",
        "productionresultssa7.blob.core.windows.net",
        "productionresultssa8.blob.core.windows.net",
        "productionresultssa9.blob.core.windows.net",
        "productionresultssa10.blob.core.windows.net",
        "productionresultssa11.blob.core.windows.net",
        "productionresultssa12.blob.core.windows.net",
        "productionresultssa13.blob.core.windows.net",
        "productionresultssa14.blob.core.windows.net",
        "productionresultssa15.blob.core.windows.net",
        "productionresultssa16.blob.core.windows.net",
        "productionresultssa17.blob.core.windows.net",
        "productionresultssa18.blob.core.windows.net",
        "productionresultssa19.blob.core.windows.net",
        "pipelines.actions.githubusercontent.com"
      ],
      "run": [
        "/opt/homebrew/bin/gh",
        "/usr/local/bin/gh",
        "/usr/bin/gh",
        "/usr/local/bin/gh",
        "C:\\Program Files\\GitHub CLI\\gh.exe",
        "/usr/bin/security",
        "/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister",
        "/usr/bin/open",
        "/Users/nightness/Source/Brainwires/denext-internal/ops/runners/pause-pool.sh",
        "/Users/nightness/Source/Brainwires/denext-internal/ops/runners/watchdog.sh",
        "/bin/launchctl"
      ],
      "write": [
        "$APPDATA",
        "/Users/nightness/.denext-runners/hooks"
      ]
    }
  }
}
