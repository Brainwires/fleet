{
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run -A jsr:@denext/denext@^4.16.0/cli dev .",
    "export": "deno run -A jsr:@denext/denext@^4.16.0/cli export .",
    "desktop": "deno run -A jsr:@denext/denext@^4.16.0/cli desktop run .",
    "desktop:build": "deno run -A jsr:@denext/denext@^4.16.0/cli desktop build .",
    "desktop:package": "deno run -A jsr:@denext/denext@^4.16.0/cli desktop package .",
    "desktop:package:windows": "deno run -A jsr:@denext/denext@^4.16.0/cli run -A scripts/package-windows.ts --arch x86_64",
    "test": "deno run -A jsr:@denext/denext@^4.16.0/cli test",
    "check": "deno fmt --check && deno lint && deno task test",
    "icons": "deno run --allow-write=icons,public tools/make-icons.ts",
    "hooks": "deno run --allow-net=127.0.0.1:8789 --allow-run=/usr/bin/security --allow-env=HOME --allow-read=$HOME/Library/LaunchAgents/com.brainwires.denext-ci-hooks-tunnel.plist,/Library/LaunchDaemons/com.brainwires.denext-ci-hooks-tunnel.plist,/Library/LaunchAgents/com.brainwires.denext-ci-hooks-tunnel.plist,$HOME/.denext-runners/hooks --allow-write=$HOME/.denext-runners/hooks hooks-only.ts",
    "mcp": "deno run --no-config --no-prompt \"--allow-read=$HOME/Library/Application Support/dev.brainwires.fleet,$HOME/.denext-runners/hooks,$HOME/.denext-runners/health.json\" mcp/fleet-mcp.ts --data-dir \"$HOME/Library/Application Support/dev.brainwires.fleet\" --hooks-dir \"$HOME/.denext-runners/hooks\" --health-file \"$HOME/.denext-runners/health.json\""
  },
  "allowScripts": {
    "deny": [
      "npm:@parcel/watcher"
    ]
  },
  "unstable": [
    "no-legacy-abort"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "denext",
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "imports": {
    "denext": "jsr:@denext/denext@^4.16.0",
    "denext/jsx-runtime": "jsr:@denext/denext@^4.16.0/jsx-runtime",
    "denext/jsx-dev-runtime": "jsr:@denext/denext@^4.16.0/jsx-dev-runtime",
    "denext/server": "jsr:@denext/denext@^4.16.0/server",
    "denext/client": "jsr:@denext/denext@^4.16.0/client",
    "denext/testing": "jsr:@denext/denext@^4.16.0/testing",
    "denext/mobile": "jsr:@denext/denext@^4.16.0/mobile",
    "denext/desktop": "jsr:@denext/denext@^4.16.0/desktop",
    "denext/desktop/client": "jsr:@denext/denext@^4.16.0/desktop/client",
    "denext/desktop/window": "jsr:@denext/denext@^4.16.0/desktop/window",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "lint": {
    "plugins": [
      "jsr:@denext/denext@^4.16.0/lint-plugin"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "exclude": [
    ".deno/",
    "out/",
    "dist/",
    ".denext/",
    "scripts/"
  ],
  "desktop": {
    "app": {
      "name": "Fleet",
      "identifier": "dev.brainwires.fleet"
    }
  },
  "compile": {
    "include": [
      ".deno-desktop/app.json"
    ]
  }
}
