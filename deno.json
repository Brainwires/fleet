{
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run -A ../../../denext/cli.ts dev .",
    "export": "deno run -A ../../../denext/cli.ts export .",
    "desktop": "deno run -A ../../../denext/cli.ts desktop run .",
    "desktop:build": "deno run -A ../../../denext/cli.ts desktop build .",
    "desktop:package": "deno run -A scripts/package-macos.ts",
    "desktop:package:windows": "deno run -A scripts/package-windows.ts",
    "test": "deno run -A ../../../denext/cli.ts test",
    "check": "deno fmt --check && deno lint && deno task test",
    "icons": "deno run --allow-write=icons,public tools/make-icons.ts",
    "hooks": "deno run --allow-net=127.0.0.1:8789 --allow-run=/usr/bin/security --allow-env=HOME --allow-read=$HOME/Library/LaunchAgents/com.brainwires.denext-ci-hooks-tunnel.plist,/Library/LaunchDaemons/com.brainwires.denext-ci-hooks-tunnel.plist,/Library/LaunchAgents/com.brainwires.denext-ci-hooks-tunnel.plist,$HOME/.denext-runners/hooks --allow-write=$HOME/.denext-runners/hooks hooks-only.ts"
  },
  "allowScripts": {
    "deny": [
      "npm:@parcel/watcher"
    ]
  },
  "unstable": [
    "no-legacy-abort"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "denext",
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "imports": {
    "denext": "../../../denext/mod.ts",
    "denext/jsx-runtime": "../../../denext/src/jsx/jsx-runtime.ts",
    "denext/jsx-dev-runtime": "../../../denext/src/jsx/jsx-runtime.ts",
    "denext/server": "../../../denext/src/server/mod.ts",
    "denext/client": "../../../denext/src/client/mod.ts",
    "denext/testing": "../../../denext/src/testing/mod.ts",
    "denext/mobile": "../../../denext/src/mobile/mod.ts",
    "denext/desktop": "../../../denext/src/build/desktop.ts",
    "denext/desktop/client": "../../../denext/src/desktop/client.ts",
    "denext/desktop/window": "../../../denext/src/desktop/window.ts",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "lint": {
    "plugins": [
      "../../../denext/src/lint/denext-plugin.ts"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "exclude": [
    ".deno/",
    "out/",
    "dist/",
    ".denext/",
    "scripts/"
  ],
  "desktop": {
    "app": {
      "name": "Fleet",
      "identifier": "dev.brainwires.fleet"
    }
  },
  "compile": {
    "include": [
      ".deno-desktop/app.json"
    ]
  }
}
